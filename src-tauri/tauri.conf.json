{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WellSnap",
  "mainBinaryName": "WellSnap",
  "version": "0.2.2",
  "identifier": "one.welldone.wellsnap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: wsnap: http://wsnap.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost wsnap: http://wsnap.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "WellDone",
    "shortDescription": "Screenshots with arrows, blur and numbered notes",
    "longDescription": "WellSnap: select an area, mark it up with arrows, pencil, rectangles, highlighter, blur and numbered notes, then copy or save. Several screenshots can be pasted into a chat at once.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "license": "GPL-3.0-or-later"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3M0E5RTE0NERCOTk2QzUKUldURmxybE5GSjQ2aDNsZjBpZVNEN3AyTVVMb1p5T0ErYndHUXhKbWJwSUNRK2s4aE5SODFhRVAK",
      "endpoints": [
        "https://github.com/hashtriton/wellsnap/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
